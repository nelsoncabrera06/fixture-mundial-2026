# Plantilla de variables de entorno.
# Copiá este archivo a ".env.local" y completá con los valores de tu proyecto
# Supabase (Project Settings → API). El .env.local NO se sube al repo.

# URL del proyecto Supabase (pública).
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave anon/public (segura para el navegador, va en el bundle del cliente).
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_public

# Clave service_role (SECRETA, solo servidor — NO lleva NEXT_PUBLIC_).
# Se usa en /api/admin/* para operaciones de admin (ej. borrar usuarios).
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role
